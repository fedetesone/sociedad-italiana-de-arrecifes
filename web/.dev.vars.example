# Only astro dev on localhost can use mock delivery and official test keys.
EMAIL_PROVIDER=mock
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production keys (RESEND_API_KEY, TURNSTILE_SECRET_KEY) are Cloudflare
# secrets of type Secret, never this file. EMAIL_FROM, EMAIL_TO and
# CONTACT_ORIGIN are public vars in wrangler.jsonc.
