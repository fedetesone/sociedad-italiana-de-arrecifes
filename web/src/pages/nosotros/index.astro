---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import RichText from "../../components/common/RichText.astro";
import { institutionalHistory } from "../../lib/history";
import { getContent } from "../../lib/content";
const { settings } = await getContent();
---

<Layout title="Nosotros">
  <section class="wrap page-intro">
    <p class="section-kicker">
      Sociedad Italiana de Socorros Mutuos "Voz de Caprera"
    </p>
    <h1>
      Raíces que nos unen.
      <br />
      Historias que continúan.
    </h1>
    <p>{settings.intro}</p>
  </section>
  <section class="wrap about-grid section-top section">
    <figure>
      <img
        class="about-photo"
        src={settings.aboutImage || "/images/italia.jpg"}
        alt={
          settings.aboutAlt ||
          "Paisaje costero de Italia, referencia de nuestras raíces culturales"
        }
        width="1000"
        height="1100"
      />
      <figcaption>
        {settings.aboutImage
          ? "Nuestra comunidad en imágenes."
          : "Italia: el paisaje de una identidad compartida."}
      </figcaption>
    </figure>
    <div>
      <h2>Nuestra historia</h2>
      <RichText
        value={
          settings.history?.length ? settings.history : institutionalHistory
        }
      />
      <h2 class="mt-12">Nuestro propósito</h2>
      <p class="lead">{settings.mission}</p>
      <a class="text-link" href="/contacto/">
        Acercate a la Sociedad ↗
      </a>
    </div>
  </section>
</Layout>
