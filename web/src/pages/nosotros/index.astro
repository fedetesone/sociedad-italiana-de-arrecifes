---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import RichText from "../../components/common/RichText.astro";
import { institutionalHistory } from "../../lib/history";
import { getContent } from "../../lib/content";
const { settings } = await getContent();
---

<Layout title="Nosotros">
  <section
    class="wrap about-section section"
    aria-labelledby="nuestra-historia"
  >
    <article class="about-story">
      <p class="section-kicker">
        Sociedad Italiana de Socorros Mutuos "Voz de Caprera"
      </p>
      <h1 id="nuestra-historia">Nuestra historia</h1>
      <figure class="about-figure">
        <img
          class="about-photo"
          class:list={{ "about-photo-navona": !settings.aboutImage }}
          src={settings.aboutImage || "/images/piazza-navona.jpg"}
          alt={
            settings.aboutAlt ||
            "Piazza Navona, en Roma, con una fuente en primer plano y una iglesia con cúpula al fondo"
          }
          width="1200"
          height="1200"
        />
        <figcaption>
          {settings.aboutImage
            ? "Nuestra comunidad en imágenes."
            : "Piazza Navona, Roma. Una mirada a nuestras raíces italianas."}
        </figcaption>
      </figure>
      <RichText
        value={
          settings.history?.length ? settings.history : institutionalHistory
        }
      />
    </article>
    <div class="about-purpose">
      <h2>Nuestro propósito</h2>
      <p class="lead">{settings.mission}</p>
      <a class="text-link" href="/contacto/">
        Acercate a la Sociedad ↗
      </a>
    </div>
  </section>
</Layout>
