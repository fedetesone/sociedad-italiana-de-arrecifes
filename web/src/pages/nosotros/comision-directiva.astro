---
export const prerender = true;
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import { getContent } from "../../lib/content";
const { settings, board } = await getContent();
---

<ServiceLayout
  title="Comisión directiva"
  kicker="Quiénes somos"
  description="Personas que acompañan la vida institucional y el trabajo cotidiano de la Sociedad."
>
  <div class="reading-panel">
    <h2>Autoridades del período vigente</h2>
    {board.members.length ? (
      <table class="board-table">
        {board.period && <caption>{board.period}</caption>}
        <thead>
          <tr>
            <th scope="col">Cargo</th>
            <th scope="col">Nombre</th>
          </tr>
        </thead>
        <tbody>
          {board.members.map((member) => (
            <tr>
              <th scope="row">{member.role}</th>
              <td>{member.name}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p>
        Estamos preparando la nómina actualizada de la comisión directiva, con
        sus cargos y período de mandato.
      </p>
    )}
    {board.note && <p class="multiline">{board.note}</p>}
    <p>
      Para comunicarte con la conducción de la institución, escribí a{" "}
      <a href={`mailto:${settings.email}`}>{settings.email}</a>.
    </p>
    <a class="button" href="/contacto/">
      Contactar a la Sociedad ↗
    </a>
  </div>
</ServiceLayout>
