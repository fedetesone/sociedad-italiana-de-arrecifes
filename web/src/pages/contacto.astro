---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import RequestForm from "../components/forms/RequestForm.astro";
import ConsulateInfo from "../components/contact/ConsulateInfo.astro";
import PublicInstitutions from "../components/contact/PublicInstitutions.astro";
import ContactLinks from "../components/contact/ContactLinks.astro";
import { getContent } from "../lib/content";
const { settings } = await getContent();
---

<Layout
  title="Contacto"
  description="Contactá a la Sociedad Italiana de Arrecifes: dirección, horarios, correo y consultas sobre actividades, socios y salones."
>
  <section class="wrap page-intro">
    <p class="section-kicker">Estamos cerca</p>
    <h1>
      El próximo encuentro
      <br />
      empieza con un “ciao”.
    </h1>
    <p>
      Para conocer más sobre la Sociedad, consultar por actividades o compartir
      una propuesta.
    </p>
  </section>
  <section class="wrap contact-grid section section-top">
    <div class="contact-panel">
      <h2>Contactanos</h2>
      <ContactLinks
        email={settings.email}
        phone={settings.phone}
        instagram={settings.instagram}
        facebook={settings.facebook}
      />
      {!settings.phone && (
        <p class="form-help">
          Por el momento, comunicate con nosotros por correo electrónico.
        </p>
      )}
      {!settings.email && !settings.phone && (
        <p>
          Pronto vamos a compartir nuestros canales de contacto en este espacio.
        </p>
      )}
    </div>
    <div>
      <h2>En Arrecifes, nuestra casa</h2>
      <p>
        {settings.address || "Arrecifes, provincia de Buenos Aires, Argentina."}
      </p>
      {settings.hours && <p>Horarios: {settings.hours}</p>}
      <p>
        Un espacio para la cultura italiana y para todas las personas que
        quieran ser parte.
      </p>
      <a class="text-link" href="/eventos/">
        Conocé la agenda ↗
      </a>
    </div>
  </section>
  <div class="wrap">
    <ConsulateInfo />
    <PublicInstitutions />
  </div>
  <div class="wrap service-body">
    <div class="narrow">
      <RequestForm kind="contacto" title="Escribile a la Sociedad" />
    </div>
  </div>
</Layout>
