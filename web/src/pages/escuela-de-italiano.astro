---
export const prerender = true;
import ServiceLayout from "../layouts/ServiceLayout.astro";
import RequestForm from "../components/forms/RequestForm.astro";
import { getContent } from "../lib/content";
const { school } = await getContent();
const levelNames = new Intl.ListFormat("es-AR", { type: "conjunction" }).format(
  school.levels.map((level) => level.name),
);
---

<ServiceLayout
  title="El italiano se aprende. La cultura se comparte."
  kicker="Escuela de italiano"
  description="Un encuentro con la lengua, las tradiciones y la vida cotidiana de Italia, en Arrecifes."
>
  <div class="school-overview">
    <div>
      <h2>Un idioma que nos acerca</h2>
      {school.intro.split(/\n\s*\n/).map((paragraph) => (
        <p class="multiline">{paragraph}</p>
      ))}
      <a class="text-link" href="#ingreso">
        Solicitar información de ingreso ↗
      </a>
    </div>
    <div class="school-facts">
      <h2>Antes de empezar</h2>
      <dl>
        <div>
          <dt>Profesor/a</dt>
          <dd>{school.teacher}</dd>
        </div>
        <div>
          <dt>Niveles</dt>
          <dd>{levelNames}.</dd>
        </div>
        <div>
          <dt>Aranceles</dt>
          <dd class="multiline">{school.fees}</dd>
        </div>
        <div>
          <dt>Días y horarios</dt>
          <dd class="multiline">{school.schedule}</dd>
        </div>
      </dl>
    </div>
  </div>
  <section class="reading-panel">
    <h2>{school.levelsTitle}</h2>
    <p class="multiline">{school.levelsIntro}</p>
    <ol class="level-list">
      {school.levels.map((level) => (
        <li>
          <strong>{level.name}</strong>
          {level.description && <span>{level.description}</span>}
        </li>
      ))}
    </ol>
    <p class="multiline">{school.note}</p>
  </section>
  <div class="narrow" id="ingreso">
    <RequestForm kind="escuela" title="Solicitud de ingreso" />
  </div>
</ServiceLayout>
