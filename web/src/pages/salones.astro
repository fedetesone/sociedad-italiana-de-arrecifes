---
export const prerender = true;
import ServiceLayout from "../layouts/ServiceLayout.astro";
import RequestForm from "../components/forms/RequestForm.astro";
import { getContent, roomId } from "../lib/content";
const { rooms } = await getContent();
const names = new Intl.ListFormat("es-AR", { type: "conjunction" }).format(
  rooms.map((room) => room.name),
);
---

<ServiceLayout
  title="Un lugar para cada encuentro"
  kicker="Alquiler de salones"
  description={`${names}. Contanos qué estás organizando y consultá por el espacio más adecuado.`}
>
  <div class="room-list">
    {rooms.map((room) => (
      <article class="room-panel" id={roomId(room.name)}>
        {room.image ? (
          <img
            class="room-photo"
            src={room.image}
            alt={room.imageAlt || ""}
            loading="lazy"
            width="300"
            height="360"
          />
        ) : (
          <div class="room-monogram" aria-hidden="true">
            {room.name.startsWith("Sala ") ? room.name[5] : "✳"}
          </div>
        )}
        <div>
          {room.tag && <p class="section-kicker">{room.tag}</p>}
          <h2>{room.name}</h2>
          {room.description && <p class="multiline">{room.description}</p>}
          {room.capacity || room.features || room.rates ? (
            <dl class="room-facts">
              {room.capacity && (
                <div>
                  <dt>Capacidad</dt>
                  <dd>{room.capacity}</dd>
                </div>
              )}
              {room.features && (
                <div>
                  <dt>Equipamiento y servicios</dt>
                  <dd class="multiline">{room.features}</dd>
                </div>
              )}
              {room.rates && (
                <div>
                  <dt>Tarifas</dt>
                  <dd class="multiline">{room.rates}</dd>
                </div>
              )}
            </dl>
          ) : (
            <p class="room-details">
              Capacidad, equipamiento, accesibilidad, tarifas y disponibilidad:
              consultar.
            </p>
          )}
          <a class="text-link" href="#consulta">
            Consultar este espacio ↗
          </a>
        </div>
      </article>
    ))}
  </div>
  <aside class="benefit-banner">
    <div>
      <h2>¿Sos socio/a?</h2>
      <p>
        Consultá la bonificación en el costo de alquiler y sus condiciones antes
        de reservar.
      </p>
    </div>
    <a class="text-link" href="/socios/bonificaciones/">
      Ver el beneficio ↗
    </a>
  </aside>
  <div class="narrow" id="consulta">
    <RequestForm kind="salones" title="Consultá por tu evento" />
  </div>
</ServiceLayout>
