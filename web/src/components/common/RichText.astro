---
import { toHTML } from "@portabletext/to-html";
import { safeUrl } from "../../lib/events/utils";
const { value = [] } = Astro.props;
const html = toHTML(value, {
  components: {
    marks: {
      link: ({ value, children }) => {
        const href = safeUrl(value?.href);
        return href
          ? `<a href="${href.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;")}">${children}</a>`
          : children;
      },
    },
  },
});
---

<div class="prose" set:html={html} />
