---
import { contactEmail } from "../../lib/navigation";
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<section class="form-panel" aria-labelledby="contact-title">
  <h2 id="contact-title">Envianos un mensaje</h2>
  <p>
    Los campos con * son obligatorios. Te responderemos al correo que indiques.
  </p>
  <form
    id="contact-form"
    class="request-form"
    action="/api/contact"
    method="post"
  >
    <div class="form-row">
      <label for="contact-name">
        Nombre *
        <input
          id="contact-name"
          name="name"
          autocomplete="name"
          required
          maxlength="100"
          aria-describedby="error-name"
        />
        <span id="error-name" data-error="name" class="field-error"></span>
      </label>
      <label for="contact-email">
        Email *
        <input
          id="contact-email"
          type="email"
          name="email"
          autocomplete="email"
          required
          maxlength="254"
          aria-describedby="error-email"
        />
        <span id="error-email" data-error="email" class="field-error"></span>
      </label>
    </div>
    <label for="contact-subject">
      Asunto *
      <input
        id="contact-subject"
        name="subject"
        required
        maxlength="140"
        aria-describedby="error-subject"
      />
      <span id="error-subject" data-error="subject" class="field-error"></span>
    </label>
    <label for="contact-message">
      Mensaje *
      <textarea
        id="contact-message"
        name="message"
        required
        rows="5"
        maxlength="5000"
        aria-describedby="message-help error-message"
        placeholder="Contanos en qué podemos ayudarte."
      ></textarea>
      <span id="error-message" data-error="message" class="field-error"></span>
    </label>
    <p id="message-help" class="form-help">
      Hasta 5000 caracteres. No incluyas documentos, datos bancarios ni
      información sensible.
    </p>
    <div class="form-honeypot" aria-hidden="true">
      <label>
        No completar
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <label class="consent" for="contact-consent">
      <input
        id="contact-consent"
        name="consent"
        type="checkbox"
        required
        aria-describedby="error-consent"
      />
      <span>
        Autorizo el uso de mis datos para responder esta consulta. Leí la{" "}
        <a href="/privacidad/">información de privacidad</a>. *
      </span>
    </label>
    <span id="error-consent" data-error="consent" class="field-error"></span>
    {sitekey ? (
      <div
        id="contact-turnstile"
        class="cf-turnstile"
        data-sitekey={sitekey}
        data-action="contact"
        data-language="es"
        data-size="flexible"
      ></div>
    ) : (
      <p class="form-help">
        El formulario no está disponible por el momento. Podés escribirnos por
        correo.
      </p>
    )}
    <span
      id="error-turnstileToken"
      data-error="turnstileToken"
      class="field-error"
    ></span>
    <button type="submit" class="button" disabled>
      Enviar consulta <span aria-hidden="true">↗</span>
    </button>
    <p
      id="contact-status"
      class="form-help"
      role="status"
      aria-live="polite"
      tabindex="-1"
    ></p>
    <noscript>
      <p>
        Para usar el formulario necesitás activar JavaScript. También podés
        escribirnos al correo que figura debajo.
      </p>
    </noscript>
  </form>
  <p class="form-help">
    También podés escribir directamente a{" "}
    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
  </p>
</section>
{sitekey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}
<script>
  import type { ContactResponse } from "../../types/contact";
  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  const button = form.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  )!;
  const status = document.querySelector<HTMLElement>("#contact-status")!;
  button.disabled = !document.querySelector("#contact-turnstile");
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (button.disabled || !form.reportValidity()) return;
    form.querySelectorAll<HTMLElement>("[data-error]").forEach((el) => {
      el.textContent = "";
    });
    form
      .querySelectorAll("[aria-invalid]")
      .forEach((el) => el.removeAttribute("aria-invalid"));
    const data = new FormData(form);
    const token = String(data.get("cf-turnstile-response") || "");
    if (!token) {
      status.textContent =
        "Esperá a que se complete la verificación de seguridad. Si no aparece, recargá la página o escribinos por correo.";
      status.focus();
      return;
    }
    button.disabled = true;
    form.setAttribute("aria-busy", "true");
    status.textContent = "Enviando tu consulta…";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify({
          name: data.get("name"),
          email: data.get("email"),
          subject: data.get("subject"),
          message: data.get("message"),
          consent: data.get("consent") === "on",
          website: data.get("website") || "",
          turnstileToken: token,
        }),
        signal: AbortSignal.timeout(25000),
      });
      const result = (await response.json()) as ContactResponse;
      if (!response.ok || !result.ok) {
        if (result.ok) throw new Error("Unexpected response");
        status.textContent = result.error.message;
        for (const [field, messages] of Object.entries(
          result.error.fields || {},
        )) {
          const label = form.querySelector<HTMLElement>(
            `[data-error="${CSS.escape(field)}"]`,
          );
          if (label) label.textContent = messages.join(" ");
          const input = form.elements.namedItem(field);
          if (input instanceof HTMLElement)
            input.setAttribute("aria-invalid", "true");
        }
      } else {
        status.textContent = result.message;
        form.reset();
      }
    } catch {
      status.textContent =
        "No pudimos confirmar el envío. Tus datos siguen en el formulario. Intentá más tarde o escribinos por correo.";
    } finally {
      button.disabled = false;
      form.removeAttribute("aria-busy");
      (
        window as Window & {
          turnstile?: { reset: (container: string) => void };
        }
      ).turnstile?.reset("#contact-turnstile");
      const invalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      (invalid || status).focus();
    }
  });
</script>
<style>
  .field-error {
    color: #8c382d;
    font-size: 0.85rem;
    font-weight: 400;
  }
  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
</style>
