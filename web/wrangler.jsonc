{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sociedad-italiana-de-arrecifes",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
  },
  // Public, non-secret settings. Keys go in Cloudflare as Secret type, never here.
  "vars": {
    "EMAIL_PROVIDER": "resend",
    // Resend test mode until the .com.ar domain is verified.
    "EMAIL_FROM": "Sociedad Italiana <onboarding@resend.dev>",
    "EMAIL_TO": "soc.italiana.arrecifes@gmail.com",
    "CONTACT_ORIGIN": "https://sociedad-italiana-de-arrecifes.soc-italiana-arrecifes.workers.dev",
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
