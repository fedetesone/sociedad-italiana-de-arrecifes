{
  "name": "sociedad-italiana-de-arrecifes",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "web",
    "studio"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:studio": "npm run dev -w studio",
    "build": "npm run build -w web",
    "build:studio": "npm run build -w studio",
    "check": "npm run check -w web && npm run check -w studio",
    "test": "node --import tsx --test web/src/lib/*.test.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "^3.15.0",
      "smol-toml": "^1.9.1"
    },
    "@module-federation/dts-plugin": {
      "undici": "^7.30.1"
    }
  }
}
